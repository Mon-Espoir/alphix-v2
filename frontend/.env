# ALPHIX - API Configuration
VITE_API_BASE_URL=https://alphix-backend.onrender.com/api/v1
VITE_APP_NAME=ALPHIX

# Sanctum Auth Mode: 'token' (for mobile-first/Capacitor JWT style storage in localStorage/SecureStorage)
# or 'cookie' (for stateful web session cookie, though token is standard for Capacitor/Mobile application)
VITE_AUTH_MODE=token

# Timeout API (ms) — 30s : echec rapide au lieu de chargement infini
VITE_API_TIMEOUT_MS=30000
