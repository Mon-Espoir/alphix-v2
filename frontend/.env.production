# ALPHIX — Configuration RELEASE PERMANENTE.
# ---------------------------------------------------------------------------
# Charge AUTOMATIQUEMENT par `vite build` (jamais en `vite dev`).
# VALEURS FIGEES : ne modifiez ce fichier que pour changer DEFINITIVEMENT
# l'URL de production (ex. domaine propre). Aucun secret ici.
# Le garde-fou du build (vite.config.js) REFUSE de compiler une release
# pointee vers localhost : l'APK pointe toujours la production.
VITE_API_BASE_URL=https://alphix-backend.onrender.com/api/v1
VITE_APP_NAME=ALPHIX

# Authentification : 'token' (JWT/Bearer, mobile-first/Capacitor). Permanent.
VITE_AUTH_MODE=token

# Timeout API (ms) : 30 s, echec rapide au lieu de chargement infini.
VITE_API_TIMEOUT_MS=30000
