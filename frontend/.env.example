# ALPHIX - API Configuration (DEV : `vite dev` charge ce fichier)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=ALPHIX
VITE_AUTH_MODE=token

VITE_API_TIMEOUT_MS=30000

# RELEASE : `vite build` charge AUTOMATIQUEMENT .env.production
# (VITE_API_BASE_URL=https://api.alphix.bi/api/v1) — ne jamais coder
# l'URL en dur, tout passe par src/config/env.js.
