# ALPHIX — Configuration RELEASE (chargée AUTOMATIQUEMENT par `vite build`,
# jamais en `vite dev` qui garde .env = localhost). Ne plus changer l'URL
# à la main avant de compiler l'APK : le build release pointe toujours la prod.
# URL Render gratuite permanente (remplacer par votre URL Render réelle après déploiement)
VITE_API_BASE_URL=https://alphix-backend.onrender.com/api/v1
VITE_APP_NAME=ALPHIX

# Sanctum Auth Mode: 'token' (mobile-first/Capacitor, Bearer en localStorage)
VITE_AUTH_MODE=token

# Timeout API (ms)
VITE_API_TIMEOUT_MS=30000
