# ALPHIX - API Configuration (`vite dev` charge ce fichier ; copier vers `.env`)
VITE_API_BASE_URL=https://alphix-backend.onrender.com/api/v1
VITE_APP_NAME=ALPHIX
VITE_AUTH_MODE=token

VITE_API_TIMEOUT_MS=30000

# RELEASE : `vite build` charge frontend/.env.production (VERSIONNE,
# permanent : pointe toujours l'API de production). Ne jamais coder
# l'URL en dur, tout passe par src/config/env.js.
