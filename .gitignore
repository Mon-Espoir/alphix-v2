# Racine ALPHIX V2 — ne jamais versionner :
# - dépendances (le vrai backend a son propre .gitignore)
/vendor/
/composer.json
/composer.lock
/node_modules/
# - copie de sauvegarde divergente (code mort)
/backend_backup/
# - secrets et configs locales
.env
.env.backup
automation/.env
# EXCEPTION PERMANENTE : frontend/.env.production ne contient AUCUN secret
# (URL publique de l'API, nom d'app, mode auth, timeout). Il est VERSIONNE
# volontairement pour que chaque `vite build` / APK pointe TOUJOURS la
# production, sans manipulation manuelle. Ne jamais y mettre de secret.
!frontend/.env.production
# - journaux et artefacts
frontend/nohup.out
nohup.out
